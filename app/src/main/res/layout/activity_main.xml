<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_language">

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvTitle"
            android:layout_width="match_parent"
            android:gravity="center"
            android:layout_height="wrap_content"
            android:layout_marginTop="50dp"
            android:fontFamily="@font/cherry_bomb_regular"
            android:text="@string/pony_maker"
            android:paddingBottom="10dp"

            android:textColor="@color/app_color"
            android:textSize="28sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:shadowColor="#80000000"
            android:shadowDx="5"
            android:shadowDy="8"
            android:shadowRadius="6"
            />
        <androidx.cardview.widget.CardView
            android:layout_width="32dp"
            android:layout_height="32dp"
            app:cardCornerRadius="6dp"
            android:layout_marginStart="16dp"
            app:layout_constraintBottom_toBottomOf="@id/tvTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/tvTitle"
            >
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:adjustViewBounds="true"
                android:scaleType="fitXY"
                android:src="@drawable/logoapp"
            />
        </androidx.cardview.widget.CardView>


        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/imvSetting"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginEnd="16dp"
            android:src="@drawable/imv_setting"
            app:layout_constraintBottom_toBottomOf="@id/tvTitle"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/tvTitle" />


        <ScrollView
            android:id="@+id/scvMain"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="50dp"
            android:layout_marginBottom="0dp"
            android:elevation="1dp"
            android:scrollbars="none"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvTitle">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <!--            gl05-->
                <androidx.constraintlayout.widget.Guideline
                    android:id="@+id/gl05"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    app:layout_constraintGuide_percent="0.37" />

                <!--            gl063-->
                <androidx.constraintlayout.widget.Guideline
                    android:id="@+id/gl063"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    app:layout_constraintGuide_begin="259dp" />

                <!--            btnCreate-->
                <ImageView
                    android:id="@+id/btnCreate"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginHorizontal="16dp"
                    android:adjustViewBounds="true"
                    android:src="@drawable/img_frame_home1"
                    app:layout_constraintTop_toTopOf="parent" />

                <!--            tv1-->
                <TextView
                    android:id="@+id/tv1"
                    style="@style/single_marquee"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_marginHorizontal="5dp"
                    android:gravity="center"
                    android:paddingStart="16dp"
                    android:fontFamily="@font/cherry_bomb_regular"
                    android:text="@string/pony_maker"
                    android:textColor="@color/white"
                    android:textSize="24sp"
                    app:layout_constraintBottom_toBottomOf="@+id/btnCreate"
                    app:layout_constraintEnd_toEndOf="@+id/gl063"
                    app:layout_constraintStart_toStartOf="@+id/btnCreate"
                    app:layout_constraintTop_toTopOf="@+id/btnCreate"
                    app:strokeJoinStyle="miter" />

                <!--            btnQuickMaker-->
                <ImageView
                    android:id="@+id/btnQuickMaker"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginTop="10dp"
                    android:adjustViewBounds="true"
                    android:src="@drawable/img_frame_home2"
                    app:layout_constraintTop_toBottomOf="@+id/btnCreate" />

                <!--            tv2-->
                <TextView
                    android:id="@+id/tv2"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_marginHorizontal="5dp"
                    android:layout_marginEnd="10dp"
                    android:gravity="center"
                    android:text="@string/trending_custom"
                    android:fontFamily="@font/cherry_bomb_regular"
                    android:textColor="@color/white"
                    android:textSize="24sp"
                    app:layout_constraintBottom_toBottomOf="@+id/btnQuickMaker"
                    app:layout_constraintEnd_toEndOf="@+id/btnQuickMaker"
                    app:layout_constraintStart_toEndOf="@id/gl05"
                    app:layout_constraintTop_toTopOf="@+id/btnQuickMaker"
                    app:strokeColor="@color/white"
                    style="@style/single_marquee"
                    app:strokeJoinStyle="miter"
                    />

                <!--            btnMyAlbum-->
                <ImageView
                    android:id="@+id/btnMyAlbum"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginTop="10dp"
                    android:adjustViewBounds="true"
                    android:src="@drawable/img_frame_home3"
                    app:layout_constraintTop_toBottomOf="@+id/btnQuickMaker" />

                <!--            tv3-->
                <TextView
                    android:id="@+id/tv3"
                    style="@style/single_marquee"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:gravity="center"
                    android:text="@string/my_work"
                    android:textColor="@color/white"
                    android:fontFamily="@font/cherry_bomb_regular"
                    android:textSize="24sp"
                    app:layout_constraintBottom_toBottomOf="@+id/btnMyAlbum"
                    app:layout_constraintEnd_toStartOf="@+id/gl063"
                    app:layout_constraintStart_toStartOf="@+id/btnMyAlbum"
                    app:layout_constraintTop_toTopOf="@+id/btnMyAlbum"
                    app:strokeColor="@color/white"
                    app:strokeJoinStyle="miter"
                    android:layout_marginHorizontal="5dp"
                    />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </ScrollView>


    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
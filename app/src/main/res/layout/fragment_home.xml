<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.main.home.HomeFragment">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/img_bg_app" />

    <!--    layoutActionBar-->
    <FrameLayout
        android:id="@+id/layoutActionBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent">

        <include
            android:id="@+id/actionBar"
            layout="@layout/layout_actionbar" />
    </FrameLayout>


    <!--    scvMain-->
    <ScrollView
        android:id="@+id/scvMain"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="0dp"
        android:elevation="1dp"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutActionBar">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.constraintlayout.widget.Guideline
                                android:id="@+id/gl05"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                app:layout_constraintGuide_percent="0.47" />
            <!--            btnManual-->
            <ImageView
                android:id="@+id/btnManual"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginHorizontal="16dp"
                android:adjustViewBounds="true"
                android:src="@drawable/img_frame_home1"
                app:layout_constraintTop_toTopOf="parent" />

            <!--            tv1-->
            <TextView
                android:id="@+id/tv1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginTop="16dp"
                android:ellipsize="end"
                android:fontFamily="@font/carter_one_regular"
                android:gravity="start"
                android:includeFontPadding="false"
                android:lineSpacingExtra="-8dp"
                android:lineSpacingMultiplier="0.9"
                android:maxLines="2"
                android:textSize="24sp"
                android:textColor="@color/white"
                app:autoSizeStepGranularity="1sp"
                android:text="@string/pony_maker"
                app:layout_constraintEnd_toStartOf="@+id/gl05"
                app:layout_constraintStart_toStartOf="@id/btnManual"
                app:layout_constraintTop_toTopOf="@id/btnManual" />

            <!--            btnAuto-->
            <ImageView
                android:id="@+id/btnAuto"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="10dp"
                android:adjustViewBounds="true"
                android:src="@drawable/img_frame_home2"
                app:layout_constraintTop_toBottomOf="@+id/btnManual" />

            <!--            tv2-->

            <TextView
                android:id="@+id/tv2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginTop="16dp"
                android:ellipsize="end"
                android:fontFamily="@font/carter_one_regular"
                android:gravity="start"
                android:includeFontPadding="false"
                android:lineSpacingExtra="-8dp"
                android:lineSpacingMultiplier="0.9"
                android:maxLines="2"
                android:textSize="24sp"
                android:textColor="@color/white"
                app:autoSizeStepGranularity="1sp"
                android:text="@string/trending_custom"

                app:layout_constraintEnd_toEndOf="@+id/gl05"
                app:layout_constraintStart_toStartOf="@+id/btnAuto"
                app:layout_constraintTop_toTopOf="@+id/btnAuto"
                />
            <!--            btnMyAlbum-->
            <ImageView
                android:id="@+id/btnMultiplayer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="10dp"
                android:adjustViewBounds="true"
                android:src="@drawable/img_frame_home3"
                app:layout_constraintTop_toBottomOf="@+id/btnAuto" />

            <!--            tv3-->

            <TextView
                android:id="@+id/tv3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginTop="16dp"
                android:ellipsize="end"
                android:fontFamily="@font/carter_one_regular"
                android:gravity="start"
                android:includeFontPadding="false"
                android:lineSpacingExtra="-8dp"
                android:lineSpacingMultiplier="0.9"
                android:maxLines="2"
                android:textSize="24sp"
                android:textColor="@color/white"
                android:text="@string/my_work"
                app:layout_constraintEnd_toEndOf="@+id/gl05"
                app:layout_constraintStart_toStartOf="@+id/btnMultiplayer"
                app:layout_constraintTop_toTopOf="@+id/btnMultiplayer"
                />
        </androidx.constraintlayout.widget.ConstraintLayout>

    </ScrollView>

    <!--    flNativeCollab-->
    <!--    <FrameLayout-->
    <!--        android:id="@+id/flNativeCollab"-->
    <!--        android:layout_width="match_parent"-->
    <!--        android:layout_height="wrap_content"-->
    <!--        android:elevation="2dp"-->
    <!--        app:layout_constraintBottom_toBottomOf="parent">-->

    <!--        <include layout="@layout/ads_native_collap_avg_shimmer" />-->
    <!--    </FrameLayout>-->
</androidx.constraintlayout.widget.ConstraintLayout>
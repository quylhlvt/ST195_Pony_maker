<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/img_bg_success"
    tools:context=".ui.main.success.SuccessFragment">

    <TextView
        android:id="@+id/txtPlayer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:fontFamily="@font/carter_one_regular"
        android:gravity="center"
        android:elevation="3dp"
        android:text="@string/player_1"
        android:layout_marginTop="56dp"
        android:textColor="@color/white"
        android:textSize="20sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/btnHome"
        app:layout_constraintTop_toTopOf="@+id/imgwin" />
    <ImageView
        android:elevation="1dp"
        android:id="@+id/imgwin"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:adjustViewBounds="true"
        android:src="@drawable/img_success_play1"
        app:layout_constraintDimensionRatio="3.6:4.32"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:elevation="2dp"
        android:id="@+id/btnHome"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="8dp"
        android:src="@drawable/img_success_home"
        app:layout_constraintDimensionRatio="1.56:0.52"
        app:layout_constraintEnd_toStartOf="@+id/btnRestart"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/imgwin" />
    <TextView
        android:elevation="3dp"
        android:id="@+id/txtHome"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintStart_toStartOf="@+id/btnHome"
        app:layout_constraintEnd_toEndOf="@+id/btnHome"
        app:layout_constraintBottom_toBottomOf="@+id/btnHome"
        app:layout_constraintTop_toTopOf="@+id/btnHome"
        android:textSize="20sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:fontFamily="@font/carter_one_regular"
        android:text="@string/home"/>

    <ImageView
        android:elevation="2dp"
        android:id="@+id/btnRestart"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="16dp"
        android:src="@drawable/img_success_restart"
        app:layout_constraintDimensionRatio="1.56:0.52"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/btnHome"
        app:layout_constraintTop_toBottomOf="@+id/imgwin" />

    <TextView
        android:elevation="3dp"
        android:id="@+id/txtPlayAgain"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:textSize="20sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:fontFamily="@font/carter_one_regular"
        app:layout_constraintStart_toStartOf="@+id/btnRestart"
        app:layout_constraintEnd_toEndOf="@+id/btnRestart"
        app:layout_constraintBottom_toBottomOf="@+id/btnRestart"
        app:layout_constraintTop_toTopOf="@+id/btnRestart"
        android:text="@string/play_again"/>
</androidx.constraintlayout.widget.ConstraintLayout>